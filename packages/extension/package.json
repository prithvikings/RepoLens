{
  "name": "repolens-extension",
  "displayName": "RepoLens",
  "description": "Understand unfamiliar codebases from inside VS Code.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "publisher": "prithvikings",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["Other"],
  "activationEvents": [
    "onCommand:repolens.open",
    "onView:repolens.overview"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "repolens.open",
        "title": "RepoLens: Open"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "repolens",
          "title": "RepoLens",
          "icon": "media/repolens.svg"
        }
      ]
    },
    "views": {
      "repolens": [
        {
          "id": "repolens.overview",
          "name": "Overview"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/__tests__/overviewMetadata.test.js dist/__tests__/overviewMetadataPhase2.test.js"
  },
  "dependencies": {
    "@repolens/core": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.0.0"
  }
}
